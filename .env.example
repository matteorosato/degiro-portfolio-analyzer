# Environment Configuration
# Copy this file to .env and adjust values as needed
# Only environment-specific variables should be here
# Constants and defaults are defined in app/core/config.py

# Environment
DEV_MODE=true

# API Server
API_HOST=localhost
API_PORT=8000

# CORS Settings (comma-separated origins, use * for development only)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
